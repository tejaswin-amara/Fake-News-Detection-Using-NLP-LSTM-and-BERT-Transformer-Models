# Copy outside the repository as a release-evidence record. Do not put secrets,
# credentials, raw article text, model weights, or live production values here.
# The preflight validator treats every blank or example value as a hard failure.
DEPLOYMENT_ENVIRONMENT=production
RELEASE_IMAGE_DIGEST=sha256:REPLACE_WITH_64_LOWERCASE_HEX_CHARACTERS
KUBERNETES_NAMESPACE=REPLACE_WITH_OWNER_APPROVED_NAMESPACE
INGRESS_HOST=REPLACE_WITH_OWNER_APPROVED_DNS_NAME
TLS_SECRET_NAME=REPLACE_WITH_OPERATOR_MANAGED_TLS_SECRET_NAME
SECRET_MANAGER_REFERENCE=REPLACE_WITH_NON_SECRET_REFERENCE_ONLY
MODEL_ARTIFACT_URI=REPLACE_WITH_GOVERNED_ARTIFACT_LOCATION
MODEL_ARTIFACT_SHA256=REPLACE_WITH_64_LOWERCASE_HEX_CHARACTERS
MODEL_ARTIFACT_SIGNATURE_REFERENCE=REPLACE_WITH_NON_SECRET_SIGNATURE_REFERENCE
REDIS_SECRET_REFERENCE=REPLACE_WITH_NON_SECRET_REDIS_SECRET_REFERENCE
PROMETHEUS_OWNER=REPLACE_WITH_OBSERVABILITY_OWNER
ON_CALL_OWNER=REPLACE_WITH_NAMED_ON_CALL_OWNER
STAGING_BASE_URL=https://REPLACE_WITH_APPROVED_STAGING_HOST
CAPACITY_TEST_AUTHORIZATION=no
ROLLBACK_IMAGE_DIGEST=sha256:REPLACE_WITH_64_LOWERCASE_HEX_CHARACTERS
ROLLBACK_MODEL_ARTIFACT_SHA256=REPLACE_WITH_64_LOWERCASE_HEX_CHARACTERS
