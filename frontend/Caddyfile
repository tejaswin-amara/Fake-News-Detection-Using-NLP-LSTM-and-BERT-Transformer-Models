:80 {
    root * /usr/share/caddy
    encode gzip zstd

    # Strict Production Security Headers
    header {
        X-Frame-Options "DENY"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self' http://localhost:8000 http://127.0.0.1:8000; frame-ancestors 'none';"
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
    }

    # Reverse proxy /api/* traffic directly to FastAPI backend service
    handle /api/* {
        reverse_proxy http://backend:8000
    }

    # Proxy root health check to backend
    handle /healthz {
        reverse_proxy http://backend:8000
    }

    # Static SPA assets with index.html fallback
    handle {
        try_files {path} /index.html
        file_server
    }
}
