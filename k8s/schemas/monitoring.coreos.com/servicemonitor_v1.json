{
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "monitoring.coreos.com/v1"},
    "kind": {"const": "ServiceMonitor"},
    "metadata": {"type": "object"},
    "spec": {
      "type": "object",
      "required": ["selector", "endpoints"],
      "properties": {
        "selector": {
          "type": "object",
          "required": ["matchLabels"],
          "properties": {"matchLabels": {"type": "object"}}
        },
        "endpoints": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["port", "path"],
            "properties": {
              "port": {"type": "string"},
              "path": {"type": "string"},
              "interval": {"type": "string"},
              "scrapeTimeout": {"type": "string"},
              "scheme": {"enum": ["http", "https"]}
            }
          }
        }
      }
    }
  }
}
