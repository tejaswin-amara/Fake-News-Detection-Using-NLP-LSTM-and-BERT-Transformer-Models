!.env.example
.envrc
*.local

# Editor and operating-system state.
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
*.swo
*~

# Data and generated artifacts
data/raw/*
data/external/*
data/processed/*
!data/raw/.gitkeep
!data/external/.gitkeep
!data/processed/.gitkeep
artifacts/*
!artifacts/.gitkeep
reports/*
!reports/.gitkeep

# Model and experiment caches
.mlruns/
mlruns/
.mlflow/
.tensorboard-info/
runs/
lightning_logs/
.cache/
.huggingface/
.hf-cache/
.torch/
.keras/

# DVC maintains source-controlled configuration but caches and temporary state are local.
.dvc/cache/
.dvc/tmp/
.dvc/plots/
.dvc/experiments/

# Model weights and portable runtime artifacts must be supplied through governed storage.
*.joblib
*.pkl
*.pickle
*.onnx
*.pt
*.pth
*.ckpt
*.safetensors
*.h5
*.keras
*.tflite

# Local services, logs, databases, and Compose overrides.
*.log
logs/
*.sqlite
*.sqlite3
*.db
docker-compose.override.yml
compose.override.yml

# Private keys, certificate material, and signing state are never source-controlled.
*.pem
*.key
*.crt
*.p12
*.pfx

# Owner-held production release evidence is validated locally and must never enter Git.
deploy/production-release-contract.env

# Coverage output
.coverage*
