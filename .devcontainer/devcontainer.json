{
  "name": "fake-news-detection-ml (Python 3.11)",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "remoteUser": "vscode",
  "postCreateCommand": "python -m pip install --upgrade pip && python -m pip install -r requirements.txt",
  "forwardPorts": [8000, 5000],
  "portsAttributes": {
    "8000": {
      "label": "FastAPI serving API",
      "onAutoForward": "notify"
    },
    "5000": {
      "label": "MLflow tracking UI",
      "onAutoForward": "notify"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "redhat.vscode-yaml",
        "ms-azuretools.vscode-docker",
        "github.vscode-github-actions",
        "ms-toolsai.jupyter"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "python.testing.pytestEnabled": true,
        "python.testing.pytestArgs": ["tests"],
        "python.analysis.typeCheckingMode": "strict",
        "editor.formatOnSave": true,
        "files.trimTrailingWhitespace": true,
        "files.insertFinalNewline": true
      }
    }
  },
  "containerEnv": {
    "PYTHONPATH": "${containerWorkspaceFolder}"
  }
}
