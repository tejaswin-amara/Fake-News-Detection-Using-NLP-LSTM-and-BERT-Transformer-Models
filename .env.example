# Copy to .env for local development; never commit real secrets.
MODEL_ARTIFACT=artifacts/models/logistic_l2.joblib
MODEL_ARTIFACT_SHA256=
PACKAGE_MANIFEST=artifacts/models/package_manifest.json
ONNX_MODEL_PATH=
SERVING_MODE=native
CALIBRATION_MANIFEST=
ARTIFACT_MANIFEST=
API_HOST=0.0.0.0
API_PORT=8000
READINESS_REQUIRES_MODEL=true
MAX_BATCH_SIZE=64
MAX_TEXT_CHARACTERS=50000
MAX_REQUEST_BYTES=1000000
MLFLOW_TRACKING_URI=mlruns
MLFLOW_EXPERIMENT_NAME=fake-news-detection
DRIFT_REFERENCE_ARTIFACT=artifacts/monitoring/reference_features.npz
DRIFT_REFERENCE_TEXTS=artifacts/monitoring/reference_texts.json
DRIFT_BASELINE_REVISION=training-reference-v1
DRIFT_REPORT_DIRECTORY=reports/monitoring
KS_ALPHA=0.05
PSI_THRESHOLD=0.20
OOV_THRESHOLD=0.20
LENGTH_SHIFT_THRESHOLD=0.20
RETRAINING_HOOK_ENABLED=true
RETRAINING_COOLDOWN_HOURS=24
RETRAINING_REQUIRES_APPROVAL=true
TRAFFIC_INTERVAL_SECONDS=5
TRAFFIC_DRIFT_EVERY=10
TRAFFIC_TIMEOUT_SECONDS=5
TRAFFIC_LOG_LEVEL=INFO
ONNX_PARITY_EPSILON=0.000009
REPORT_DIR=reports
PACKAGE_MANIFEST=artifacts/models/package_manifest.json

# API security boundary; production must set an explicit origin allowlist.
CORS_ALLOWED_ORIGINS=
CORS_ALLOW_CREDENTIALS=false
CORS_ALLOWED_METHODS=GET,POST,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,X-Request-ID
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_CLIENTS=10000
TRUSTED_PROXY_IPS=
WEB_CONCURRENCY=1
DISTRIBUTED_RATE_LIMITER=redis

# ONNX Runtime resource controls.
ONNX_EXECUTION_PROVIDERS=CPUExecutionProvider
ONNX_INTRA_OP_THREADS=1
ONNX_INTER_OP_THREADS=1
ONNX_GRAPH_OPTIMIZATION=ORT_ENABLE_ALL
ONNX_CPU_MEM_ARENA=true

# Resilient tracking controls.
MLFLOW_RETRY_ATTEMPTS=3
MLFLOW_RETRY_BACKOFF_SECONDS=0.5
MLFLOW_LOCAL_FALLBACK_URI=mlruns
MLFLOW_FAIL_ON_REMOTE_ERROR=false

# Zero-trust native artifact verification. Production requires an Ed25519 public key.
REQUIRE_SIGNED_ARTIFACT=true
ARTIFACT_PUBLIC_KEY_B64=

# Air-gapped Hugging Face model bundle.
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
HF_MODEL_DIR=/app/models/bert-base-uncased

# Distributed limiter and bounded asynchronous drift. Use a URL-safe secret in deployment.
REDIS_PASSWORD=replace-with-a-long-random-url-safe-secret
REDIS_URL=redis://:replace-with-a-long-random-url-safe-secret@redis:6379/0
REDIS_RATE_LIMIT_KEY_PREFIX=fake-news:ratelimit:
REDIS_CIRCUIT_FAILURE_THRESHOLD=3
REDIS_CIRCUIT_RECOVERY_SECONDS=30
MAX_INFLIGHT_INFERENCE=4
DRIFT_QUEUE_MAXSIZE=128
DRIFT_JOB_TTL_SECONDS=900
DRIFT_WORKERS=2
